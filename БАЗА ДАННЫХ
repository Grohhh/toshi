CREATE TABLE IF NOT EXISTS buildings (
    building_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    address VARCHAR(255),
    total_floors INTEGER NOT NULL DEFAULT 1,
    built_year INTEGER,
    is_active BOOLEAN DEFAULT TRUE
);


CREATE TABLE IF NOT EXISTS floors (
    floor_id SERIAL PRIMARY KEY,
    building_id INTEGER NOT NULL REFERENCES buildings(building_id) ON DELETE CASCADE,
    floor_number INTEGER NOT NULL,
    total_rooms INTEGER DEFAULT 0,
    UNIQUE (building_id, floor_number)
);


CREATE TABLE IF NOT EXISTS rooms (
    room_id SERIAL PRIMARY KEY,
    floor_id INTEGER NOT NULL REFERENCES floors(floor_id) ON DELETE CASCADE,
    room_number VARCHAR(20) NOT NULL,
    total_beds INTEGER NOT NULL DEFAULT 1,
    occupied_beds INTEGER NOT NULL DEFAULT 0,
    room_type VARCHAR(50) DEFAULT 'стандарт',
    status VARCHAR(20) NOT NULL DEFAULT 'свободна' 
        CHECK (status IN ('свободна', 'занята', 'в ремонте', 'забронирована')),
    floor_area DECIMAL(10,2),
    notes TEXT,
    UNIQUE (floor_id, room_number)
);


CREATE TABLE IF NOT EXISTS students (
    student_id SERIAL PRIMARY KEY,
    student_code VARCHAR(20) UNIQUE NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    middle_name VARCHAR(100),
    birth_date DATE NOT NULL,
    gender VARCHAR(10) DEFAULT 'м',
    phone VARCHAR(20),
    email VARCHAR(100),
    group_name VARCHAR(50),
    course INTEGER,
    faculty VARCHAR(100),
    enrollment_date DATE,
    is_active BOOLEAN DEFAULT TRUE
);

CREATE TABLE IF NOT EXISTS residents (
    resident_id SERIAL PRIMARY KEY,
    student_id INTEGER NOT NULL REFERENCES students(student_id) ON DELETE CASCADE,
    room_id INTEGER NOT NULL REFERENCES rooms(room_id) ON DELETE RESTRICT,
    bed_number INTEGER NOT NULL,
    check_in_date DATE NOT NULL DEFAULT CURRENT_DATE,
    check_out_date DATE,
    contract_number VARCHAR(50),
    contract_date DATE,
    parent_name VARCHAR(200),
    parent_phone VARCHAR(20),
    status VARCHAR(20) NOT NULL DEFAULT 'проживает'
        CHECK (status IN ('проживает', 'выселен', 'ожидает', 'отчислен')),
    notes TEXT,
    UNIQUE (student_id, status),
    CHECK (bed_number > 0)
);


CREATE TABLE IF NOT EXISTS waiting_list (
    waiting_id SERIAL PRIMARY KEY,
    student_id INTEGER NOT NULL REFERENCES students(student_id) ON DELETE CASCADE,
    application_date DATE NOT NULL DEFAULT CURRENT_DATE,
    priority INTEGER DEFAULT 1,
    preferred_building INTEGER REFERENCES buildings(building_id),
    preferred_room_type VARCHAR(50) DEFAULT 'стандарт',
    status VARCHAR(20) NOT NULL DEFAULT 'в очереди'
        CHECK (status IN ('в очереди', 'заселен', 'отказался', 'отменен')),
    notes TEXT,
    UNIQUE (student_id, status)
);

CREATE TABLE IF NOT EXISTS contracts (
    contract_id SERIAL PRIMARY KEY,
    contract_number VARCHAR(50) UNIQUE NOT NULL,
    contract_date DATE NOT NULL DEFAULT CURRENT_DATE,
    student_id INTEGER NOT NULL REFERENCES students(student_id) ON DELETE CASCADE,
    room_id INTEGER NOT NULL REFERENCES rooms(room_id),
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    monthly_fee DECIMAL(10,2) DEFAULT 0,
    status VARCHAR(20) NOT NULL DEFAULT 'активен'
        CHECK (status IN ('активен', 'завершен', 'расторгнут', 'ожидает')),
    signed_by_student BOOLEAN DEFAULT FALSE,
    signed_by_admin BOOLEAN DEFAULT FALSE,
    scan_path VARCHAR(500),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS users (
    user_id SERIAL PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(20) NOT NULL DEFAULT 'менеджер'
        CHECK (role IN ('администратор', 'менеджер', 'комендант')),
    full_name VARCHAR(200),
    email VARCHAR(100),
    phone VARCHAR(20),
    is_active BOOLEAN DEFAULT TRUE,
    last_login TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


CREATE TABLE IF NOT EXISTS student_movement_log (
    log_id SERIAL PRIMARY KEY,
    student_id INTEGER NOT NULL REFERENCES students(student_id),
    from_room_id INTEGER REFERENCES rooms(room_id),
    to_room_id INTEGER REFERENCES rooms(room_id),
    from_bed_number INTEGER,
    to_bed_number INTEGER,
    move_date DATE NOT NULL DEFAULT CURRENT_DATE,
    move_type VARCHAR(50) DEFAULT 'переселение'
        CHECK (move_type IN ('заселение', 'выселение', 'переселение', 'временное')),
    reason TEXT,
    user_id INTEGER REFERENCES users(user_id),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Журнал событий системы
CREATE TABLE IF NOT EXISTS system_log (
    log_id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(user_id),
    action_type VARCHAR(50) NOT NULL,
    table_name VARCHAR(50),
    record_id INTEGER,
    old_values JSONB,
    new_values JSONB,
    ip_address VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
